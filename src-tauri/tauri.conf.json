{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogiComms",
  "version": "0.1.0",
  "identifier": "eu.igportals.logicomms",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogiComms",
        "width": 800,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRjQ1OTc0RjI2Rjg2MDUKUldRRmhtL3lkRm4wVHA1RGtQVzdsOE9yWnJ6NzhSNDZwRUEzM0M2VEpJWVpISXdITFFyL0U1SEcK",
      "endpoints": [
        "https://logicomms.igportals.eu/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
