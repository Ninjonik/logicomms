{
  "build": {
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "LogiComms",
  "version": "0.1.0",
  "identifier": "com.logicomms.desktop",
  "plugins": {
    "process": {
      "active": true
    },
    "updater": {
      "endpoints": [
        "https://logicomms.igportals.eu/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "LogiComms",
        "width": 1320,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 760,
        "dragDropEnabled": false
      }
    ]
  }
}
