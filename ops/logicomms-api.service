[Unit]
Description=LogiComms API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/services/logicomms
Environment=NODE_ENV=production
EnvironmentFile=/home/services/logicomms/backend/.env
Environment=PATH=/root/.nvm/versions/node/v26.5.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.nvm/versions/node/v26.5.1/bin/node backend/src/server.mjs
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
